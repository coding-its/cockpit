# Wartungscockpit – lokale Konfiguration
# Kopieren nach .env und anpassen.

PORT=8080
STATIC_DIR=apps/web/dist

# Datenbank (PostgreSQL). Die Verbindungsdaten stehen in data/db.json und
# lassen sich auch in der Anwendung unter Einstellungen → Datenbank ändern.
# DATABASE_URL überschreibt die Datei – nur für Tests und Sonderfälle.
# DATABASE_URL=postgres://benutzer:passwort@127.0.0.1:5432/wartungscockpit

# NinjaOne Public API v2
# Ohne Client-ID/Secret startet die App automatisch im Mock-Modus.
NINJAONE_MOCK=true
NINJAONE_BASE_URL=https://eu.ninjarmm.com
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=
# Wichtig: Werte mit Leerzeichen müssen in Anführungszeichen stehen.
# Ohne Quotes bricht der Parser ab und alle folgenden Zeilen werden ignoriert.
NINJAONE_SCOPE="monitoring management"

# Zweite NinjaOne-App mit Benutzerkontext: für script/run verlangt NinjaOne
# einen echten Benutzer (sonst 403 user_context_required).
# App-Typ: Webanwendung mit Redirect-URI + Authorization Code + Refresh Token.
NINJAONE_USER_CLIENT_ID=
NINJAONE_USER_CLIENT_SECRET=
NINJAONE_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/ninjaone/callback

# WordPress-Agent (Phase 1)
WP_AGENT_SHARED_SECRET=change-me-in-production

# Erster Administrator. Nur beim allerersten Start wirksam.
# Ohne ADMIN_PASSWORD wird ein zufaelliges Passwort erzeugt und im Log ausgegeben.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator
# ADMIN_PASSWORD=

# Cookies nur ueber HTTPS senden. Fuer lokalen HTTP-Betrieb false lassen.
SESSION_COOKIE_SECURE=false
