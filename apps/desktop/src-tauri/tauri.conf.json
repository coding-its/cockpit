{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wartungscockpit",
  "version": "0.1.14",
  "identifier": "de.itsolutio.wartungscockpit",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wartungscockpit",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "de-DE"
      }
    },
    "shortDescription": "Wartungscockpit",
    "longDescription": "Wartungsläufe, Zeiterfassung und Abrechnung für NinjaOne und WordPress."
  }
}
